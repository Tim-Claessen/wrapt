---
// Mirrors SPEC's "Trends row": big mono rank · art · title/meta · movement indicator.
// Movement is only meaningful when `computed` is true (native Spotify windows have no prior-period data).
import type { LeaderboardEntry } from '../lib/leaderboard';

interface Props {
  entry: LeaderboardEntry;
  computed: boolean;
  shape: 'circle' | 'square';
}
const { entry, computed, shape } = Astro.props;

const delta = computed && entry.prevRank !== null ? entry.prevRank - entry.rank : null;
---

<div class="lb-row">
  <div class="lb-row__rank mono">{entry.rank}</div>
  <div class:list={['lb-row__art', { 'lb-row__art--circle': shape === 'circle' }]}>
    {entry.image ? <img src={entry.image} alt="" loading="lazy" /> : <div class="lb-row__art-fallback" />}
  </div>
  <div class="lb-row__meta">
    <div class="lb-row__title">{entry.title}</div>
    {entry.subtitle && <div class="lb-row__subtitle">{entry.subtitle}</div>}
  </div>
  {
    computed && (
      <div class="lb-row__movement mono">
        {entry.prevRank === null ? (
          <span class="lb-row__pill lb-row__pill--new">NEW</span>
        ) : delta && delta > 0 ? (
          <span class="lb-row__delta lb-row__delta--up">▲ {delta}</span>
        ) : delta && delta < 0 ? (
          <span class="lb-row__delta lb-row__delta--down">▼ {Math.abs(delta)}</span>
        ) : (
          <span class="lb-row__delta lb-row__delta--steady">•</span>
        )}
      </div>
    )
  }
</div>

<style>
  .lb-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .lb-row__rank {
    width: 22px;
    flex: 0 0 auto;
    font-size: 15px;
    font-weight: 700;
    color: var(--text-3);
    text-align: center;
  }

  .lb-row__art {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border-radius: 10px;
    overflow: hidden;
    background: linear-gradient(140deg, #4a4538, #1a1812);
  }

  .lb-row__art--circle {
    border-radius: 50%;
  }

  .lb-row__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lb-row__art-fallback {
    width: 100%;
    height: 100%;
  }

  .lb-row__meta {
    flex: 1 1 auto;
    min-width: 0;
  }

  .lb-row__title {
    font-size: 14.5px;
    color: var(--text-1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lb-row__subtitle {
    margin-top: 2px;
    font-size: 12.5px;
    color: var(--text-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lb-row__movement {
    flex: 0 0 auto;
    font-size: 12.5px;
  }

  .lb-row__pill--new {
    background: var(--gold);
    color: var(--gold-on);
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 8px;
  }

  .lb-row__delta--up {
    color: var(--up);
  }

  .lb-row__delta--down {
    color: var(--down);
  }

  .lb-row__delta--steady {
    color: var(--text-4);
  }
</style>
