---
// Mirrors SPEC's "Trends row": big mono rank · art · title/meta · plays+minutes · movement.
// Movement is only meaningful when `showMovement` is true — the `all` window has no comparable
// prior period. When `href` is set the whole row becomes a drill-down link (e.g. artist → their
// tracks) with a hover affordance.
import type { LeaderboardEntry } from '../lib/leaderboard';
import { formatMinutes } from '../lib/format';

interface Props {
  entry: LeaderboardEntry;
  showMovement: boolean;
  shape: 'circle' | 'square';
  href?: string | null;
}
const { entry, showMovement, shape, href } = Astro.props;

const delta = showMovement && entry.prevRank !== null ? entry.prevRank - entry.rank : null;
const Wrapper = href ? 'a' : 'div';
const minutes = entry.totalMs && entry.totalMs > 0 ? formatMinutes(entry.totalMs) : null;
---

<Wrapper class:list={['lb-row', { 'lb-row--link': Boolean(href) }]} {...(href ? { href } : {})}>
  <div class="lb-row__rank mono">{entry.rank}</div>
  <div class:list={['lb-row__art', { 'lb-row__art--circle': shape === 'circle' }]}>
    {entry.image ? <img src={entry.image} alt="" loading="lazy" /> : <div class="lb-row__art-fallback" />}
  </div>
  <div class="lb-row__meta">
    <div class="lb-row__title">{entry.title}</div>
    {entry.subtitle && <div class="lb-row__subtitle">{entry.subtitle}</div>}
  </div>
  {
    entry.playCount !== null && (
      <div class="lb-row__stats mono">
        <span class="lb-row__plays" title={`${entry.playCount} plays this period`}>{entry.playCount} plays</span>
        {minutes && <span class="lb-row__mins">{minutes}</span>}
      </div>
    )
  }
  {
    showMovement && (
      <div class="lb-row__movement mono">
        {entry.prevRank === null ? (
          <span class="lb-row__pill lb-row__pill--new" title="New to the ranking this period">NEW</span>
        ) : delta && delta > 0 ? (
          <span class="lb-row__delta lb-row__delta--up" title={`Up ${delta} ${delta === 1 ? 'place' : 'places'} in the ranking`}>▲ {delta}</span>
        ) : delta && delta < 0 ? (
          <span class="lb-row__delta lb-row__delta--down" title={`Down ${Math.abs(delta)} ${Math.abs(delta) === 1 ? 'place' : 'places'} in the ranking`}>▼ {Math.abs(delta)}</span>
        ) : (
          <span class="lb-row__delta lb-row__delta--steady" title="No change in rank">•</span>
        )}
      </div>
    )
  }
  {href && <span class="lb-row__chevron" aria-hidden="true">›</span>}
</Wrapper>

<style>
  .lb-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
    color: inherit;
  }

  .lb-row--link {
    cursor: pointer;
    transition: background 0.12s ease;
    border-radius: 10px;
    padding: 10px 8px;
    margin: 0 -8px;
  }

  .lb-row--link:hover {
    background: var(--surface-raised);
  }

  .lb-row__rank {
    width: 22px;
    flex: 0 0 auto;
    font-size: 15px;
    font-weight: 700;
    color: var(--text-3);
    text-align: center;
  }

  .lb-row__art {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border-radius: 10px;
    overflow: hidden;
    background: linear-gradient(140deg, #4a4538, #1a1812);
  }

  .lb-row__art--circle {
    border-radius: 50%;
  }

  .lb-row__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lb-row__art-fallback {
    width: 100%;
    height: 100%;
  }

  .lb-row__meta {
    flex: 1 1 auto;
    min-width: 0;
  }

  .lb-row__title {
    font-size: 14.5px;
    color: var(--text-1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lb-row__subtitle {
    margin-top: 2px;
    font-size: 12.5px;
    color: var(--text-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lb-row__stats {
    flex: 0 0 auto;
    text-align: right;
    line-height: 1.25;
  }

  .lb-row__plays {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-1);
    font-variant-numeric: tabular-nums;
  }

  .lb-row__mins {
    display: block;
    font-size: 10.5px;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .lb-row__movement {
    flex: 0 0 auto;
    width: 34px;
    text-align: right;
    font-size: 12.5px;
  }

  .lb-row__pill--new {
    background: var(--gold);
    color: var(--gold-on);
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 8px;
  }

  .lb-row__delta--up {
    color: var(--up);
  }

  .lb-row__delta--down {
    color: var(--down);
  }

  .lb-row__delta--steady {
    color: var(--text-4);
  }

  .lb-row__chevron {
    flex: 0 0 auto;
    color: var(--text-4);
    font-size: 18px;
    margin-left: -4px;
  }
</style>
