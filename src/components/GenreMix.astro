---
// Genre mix — magnitude comparison, so sequential gold bars (dataviz: "compare magnitude → bar,
// sequential one hue"). Every bar is direct-labeled with its own count, so no legend or tooltip
// is needed — the value's always visible, never gated behind hover.
interface Props {
  genres: { genre: string; playCount: number }[];
}
const { genres } = Astro.props;
const max = Math.max(...genres.map((g) => g.playCount), 1);
---

{
  genres.length > 0 && (
    <div class="genre-mix">
      {genres.map((g) => (
        <div class="genre-mix__row">
          <div class="genre-mix__head">
            <span class="genre-mix__name">{g.genre}</span>
            <span class="genre-mix__count mono">{g.playCount}</span>
          </div>
          <div class="genre-mix__track">
            <div class="genre-mix__fill" style={`width:${Math.max((g.playCount / max) * 100, 4)}%;`} />
          </div>
        </div>
      ))}
    </div>
  )
}

<style>
  .genre-mix {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .genre-mix__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }

  .genre-mix__name {
    font-size: 13.5px;
    color: var(--text-1);
    text-transform: capitalize;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .genre-mix__count {
    flex: 0 0 auto;
    font-size: 11px;
    color: var(--text-3);
  }

  .genre-mix__track {
    margin-top: 6px;
    height: 6px;
    border-radius: 3px;
    background: var(--surface-raised);
    overflow: hidden;
  }

  .genre-mix__fill {
    height: 100%;
    border-radius: 3px;
    background: var(--gold);
  }
</style>
