---
import AppShell from '../layouts/AppShell.astro';
import RangeToggle from '../components/RangeToggle.astro';
import LeaderboardRow from '../components/LeaderboardRow.astro';
import ImportCallout from '../components/ImportCallout.astro';
import TrendChart from '../components/TrendChart.astro';
import ListeningHeatmap from '../components/ListeningHeatmap.astro';
import EmptyState from '../components/EmptyState.astro';
import Skeleton from '../components/Skeleton.astro';
import { createSupabaseServerClient, createSupabaseServiceClient } from '../lib/supabase';
import {
  getLeaderboard,
  getPlaysHistorySince,
  resolveWindowRange,
  type LeaderboardKind,
  type LeaderboardWindow,
} from '../lib/leaderboard';
import {
  getListeningHeatmap,
  getListeningSummary,
  getListeningTrend,
  getRecentPlays,
  pickTrendBucket,
} from '../lib/stats';
import { computeDelta, formatCompactNumber, formatMinutes } from '../lib/format';
import { getImportProgress } from '../lib/import';

const env = Astro.locals.runtime.env;
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies, env);
const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) return Astro.redirect('/login');

const { data: profile } = await supabase
  .from('spotify_profiles')
  .select('id, display_name')
  .eq('user_id', user.id)
  .maybeSingle();

if (!profile) return Astro.redirect('/connect');

const url = Astro.url;

const KINDS: { value: LeaderboardKind; label: string }[] = [
  { value: 'artists', label: 'Artists' },
  { value: 'tracks', label: 'Tracks' },
];
const WINDOWS: { value: LeaderboardWindow; label: string }[] = [
  { value: '7d', label: '7 days' },
  { value: '30d', label: '30 days' },
  { value: '6m', label: '6 months' },
  { value: 'all', label: 'All time' },
  { value: 'custom', label: 'Custom' },
];

const kindParam = url.searchParams.get('kind');
const activeKind: LeaderboardKind = KINDS.some((k) => k.value === kindParam)
  ? (kindParam as LeaderboardKind)
  : 'artists';

const windowParam = url.searchParams.get('window');
const activeWindow: LeaderboardWindow = WINDOWS.some((w) => w.value === windowParam)
  ? (windowParam as LeaderboardWindow)
  : '30d';

// Drill-down: ?artist=<name> shows that one artist's tracks (the tracks leaderboard, filtered to one
// artist). It forces the tracks view regardless of which kind tab is selected.
const drillArtist = url.searchParams.get('artist');
const effectiveKind: LeaderboardKind = drillArtist ? 'tracks' : activeKind;

const sinceParam = url.searchParams.get('since');
const untilParam = url.searchParams.get('until');
const customSince = activeWindow === 'custom' && sinceParam ? new Date(sinceParam) : undefined;
const customUntil = activeWindow === 'custom' && untilParam ? new Date(`${untilParam}T23:59:59`) : undefined;
const hasCustomRange = Boolean(customSince && customUntil);
// A custom window with no dates picked yet still needs *something* to query — default to the last
// 7 days for data while the date form itself keeps showing so the user can refine it.
const queryWindow: LeaderboardWindow = activeWindow === 'custom' && !hasCustomRange ? '7d' : activeWindow;

const service = createSupabaseServiceClient(env);

const range = resolveWindowRange(
  queryWindow,
  queryWindow === 'custom' ? { since: customSince!, until: customUntil! } : undefined,
);
const trendBucket = pickTrendBucket(range);

let hasMovement = false;
let entries: Awaited<ReturnType<typeof getLeaderboard>>['entries'] = [];
let historySince: Date | null = null;
let importProgress: Awaited<ReturnType<typeof getImportProgress>> = { total: 0, done: 0, failed: 0, pending: 0 };
let recentPlays: Awaited<ReturnType<typeof getRecentPlays>> = [];
let summary: Awaited<ReturnType<typeof getListeningSummary>> = {
  current: { totalMs: 0, totalPlays: 0, distinctTracks: 0, distinctArtists: 0, activeDays: 0 },
  previous: null,
};
let trend: Awaited<ReturnType<typeof getListeningTrend>> = [];
let heatmap: Awaited<ReturnType<typeof getListeningHeatmap>> = {
  grid: Array.from({ length: 7 }, () => Array(24).fill(0)),
  max: 0,
};
let loadError: string | null = null;

try {
  [
    { hasMovement, entries },
    historySince,
    importProgress,
    recentPlays,
    summary,
    trend,
    heatmap,
  ] = await Promise.all([
    getLeaderboard({
      supabase: service,
      profileId: profile.id,
      kind: effectiveKind,
      window: queryWindow,
      customSince,
      customUntil,
      artist: drillArtist,
      limit: 10,
    }),
    getPlaysHistorySince(service, profile.id),
    getImportProgress(service, profile.id),
    getRecentPlays(service, profile.id, 12),
    getListeningSummary(service, profile.id, range),
    getListeningTrend(service, profile.id, range, trendBucket),
    getListeningHeatmap(service, profile.id, range),
  ]);
} catch {
  loadError = 'Something went wrong loading your dashboard. Try refreshing.';
}

function buildHref(overrides: Record<string, string | null>): string {
  const params = new URLSearchParams(url.searchParams);
  for (const [key, value] of Object.entries(overrides)) {
    if (value === null) params.delete(key);
    else params.set(key, value);
  }
  const query = params.toString();
  return query ? `${url.pathname}?${query}` : url.pathname;
}

const rowShape = effectiveKind === 'artists' ? 'circle' : 'square';

// Per-row drill link: an artist row opens that artist's tracks. Track rows are leaves — no link.
function rowHref(entry: (typeof entries)[number]): string | null {
  if (drillArtist) return null;
  if (effectiveKind === 'artists') return buildHref({ artist: entry.title });
  return null;
}

const historyDaysAgo = historySince
  ? Math.max(1, Math.round((Date.now() - historySince.getTime()) / (24 * 60 * 60 * 1000)))
  : null;

const activeWindowLabel = WINDOWS.find((w) => w.value === activeWindow)?.label ?? activeWindow;

// The whole hero reflects the selected window, so its comparison story does too: 'all' has no prior
// period (see resolveWindowRange), every other window diffs against an equal-length prior period.
const hasPrev = summary.previous !== null;
const compareText =
  activeWindow === 'custom' ? 'the previous period' : `the previous ${activeWindowLabel.toLowerCase()}`;
// Phrase for "times played …" in the rankings legend — 'all' reads as "all-time", not "this all time".
const playsPhrase =
  activeWindow === 'custom' ? 'this range' : activeWindow === 'all' ? 'all-time' : `this ${activeWindowLabel.toLowerCase()}`;
const heroEyebrow =
  activeWindow === 'all' ? 'All time' : activeWindow === 'custom' ? 'Custom range' : `Last ${activeWindowLabel.toLowerCase()}`;

const rawMinutes = Math.round(summary.current.totalMs / 60000);

const heroStats = [
  {
    label: 'Plays',
    value: formatCompactNumber(summary.current.totalPlays),
    delta: summary.previous ? computeDelta(summary.current.totalPlays, summary.previous.totalPlays) : null,
  },
  {
    label: 'Artists',
    value: formatCompactNumber(summary.current.distinctArtists),
    delta: summary.previous ? computeDelta(summary.current.distinctArtists, summary.previous.distinctArtists) : null,
  },
  {
    label: 'Tracks',
    value: formatCompactNumber(summary.current.distinctTracks),
    delta: summary.previous ? computeDelta(summary.current.distinctTracks, summary.previous.distinctTracks) : null,
  },
  { label: 'Active days', value: String(summary.current.activeDays), delta: null },
];

const topEntry = entries[0] ?? null;
const kindSingular = effectiveKind === 'artists' ? 'artist' : 'track';
const topMoveDelta =
  topEntry && hasMovement && topEntry.prevRank !== null ? topEntry.prevRank - topEntry.rank : null;

// Album-art mosaic behind the hero number — "your music, as image". Pooled from whatever art we
// already fetched (leaderboard + recent plays), cycled to fill the band; gradient tiles stand in
// for anything not yet enriched, so it degrades gracefully on a cold start.
const TILE_GRADIENTS = [
  'linear-gradient(145deg,#5b4a63,#241c2b)',
  'linear-gradient(145deg,#3f5450,#141d1a)',
  'linear-gradient(145deg,#63514a,#2a1f1a)',
  'linear-gradient(145deg,#4a5566,#191f28)',
  'linear-gradient(145deg,#665a45,#282116)',
  'linear-gradient(145deg,#54486a,#201a2b)',
];
const imagePool = [...entries.map((e) => e.image), ...recentPlays.map((r) => r.albumImage)].filter(
  (x): x is string => Boolean(x),
);
const mosaicTiles = Array.from({ length: 48 }, (_, i) => (imagePool.length ? imagePool[i % imagePool.length] : null));

const trendPoints = trend.map((point) => ({
  label:
    trendBucket === 'week'
      ? `Wk ${point.bucketStart.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}`
      : point.bucketStart.toLocaleDateString('en-US', { month: 'numeric', day: 'numeric' }),
  value: point.playCount,
}));
---

<AppShell title="Dashboard" wide nav>
  <div id="dashboard-content">
    <div class="dash-head">
      <span class="eyebrow mono">Hey, {profile.display_name ?? 'there'}</span>
      <div class="dash-callout"><ImportCallout progress={importProgress} /></div>
    </div>

    {loadError && <p class="load-error mono">{loadError}</p>}

    {
      !loadError && historySince === null && (
        <EmptyState
          title="Still learning your taste"
          body="Play a few tracks and check back — your dashboard fills in as you listen."
          hint="◷ syncing your last plays…"
        />
      )
    }

    {
      !loadError && historySince !== null && (
        <Fragment>
          <div class="dash-ranges">
            <RangeToggle
              options={WINDOWS}
              active={activeWindow}
              buildHref={(value) => buildHref({ window: value, since: null, until: null })}
            />
          </div>

          {
            activeWindow === 'custom' && (
              <form method="get" class="custom-range-form">
                <input type="hidden" name="kind" value={activeKind} />
                <input type="hidden" name="window" value="custom" />
                <input type="date" name="since" value={sinceParam ?? ''} required class="custom-range-form__input" />
                <input type="date" name="until" value={untilParam ?? ''} required class="custom-range-form__input" />
                <button type="submit" class="custom-range-form__submit">
                  Go
                </button>
              </form>
            )
          }

          {/* HERO — minutes as the headline, over an album mosaic */}
          <section class="hero">
            <div class="hero__mosaic" aria-hidden="true">
              {mosaicTiles.map((src, i) =>
                src ? (
                  <div class="hero__tile" style={`background-image:url('${src}')`} />
                ) : (
                  <div class="hero__tile" style={`background:${TILE_GRADIENTS[i % TILE_GRADIENTS.length]}`} />
                ),
              )}
            </div>
            <div class="hero__scrim" aria-hidden="true" />
            <div class="hero__body">
              <div class="eyebrow mono">{heroEyebrow}</div>
              <div class="hero__figure">
                <div class="hero__minutes mono">{rawMinutes.toLocaleString()}</div>
                <div class="hero__unit">
                  minutes listened
                  <br />
                  <b>{formatMinutes(summary.current.totalMs)}</b>
                </div>
              </div>

              <div class="hero__stats">
                {heroStats.map((s) => (
                  <div class="ministat">
                    <span class="ministat__v mono">{s.value}</span>
                    <span class="ministat__l mono">{s.label}</span>
                    {s.delta && s.delta.direction !== 'flat' && (
                      <span class:list={['ministat__d', 'mono', s.delta.direction === 'up' ? 'up' : 'down']}>
                        {s.delta.direction === 'up' ? '▲' : '▼'}
                        {s.delta.percent === null ? ' new' : ` ${s.delta.percent}%`}
                      </span>
                    )}
                  </div>
                ))}
              </div>

              <div class="hero__compare mono">
                {hasPrev ? `▲▼ = % change in these totals vs. ${compareText}` : 'All of your listening — no prior period to compare.'}
              </div>
            </div>
          </section>

          {
            historyDaysAgo !== null && historyDaysAgo < 7 && (
              <p class="history-note mono">
                History since {historyDaysAgo === 1 ? 'yesterday' : `${historyDaysAgo} days ago`} — it fills in as we go.
              </p>
            )
          }

          {/* #1 + rankings */}
          <section class="rank-sec">
            {
              topEntry && !drillArtist && (
                <div class="one">
                  <div
                    class:list={['one__art', { 'one__art--circle': rowShape === 'circle' }]}
                    style={
                      topEntry.image
                        ? `background-image:url('${topEntry.image}')`
                        : `background:${TILE_GRADIENTS[0]}`
                    }
                  />
                  <div class="one__meta">
                    <span class="one__badge mono">Your #1 {kindSingular}</span>
                    <div class="one__name">{topEntry.title}</div>
                    <div class="one__sub">
                      {topEntry.playCount !== null && (
                        <span class="mono">
                          {topEntry.playCount} plays{topEntry.totalMs && topEntry.totalMs > 0 ? ` · ${formatMinutes(topEntry.totalMs)}` : ''}
                        </span>
                      )}
                      {topEntry.subtitle && <span class="one__by">{topEntry.subtitle}</span>}
                      {hasMovement && topEntry.prevRank === null && <span class="chip chip--new">NEW</span>}
                      {hasMovement && topMoveDelta !== null && topMoveDelta > 0 && (
                        <span class="chip chip--up">▲ {topMoveDelta} {topMoveDelta === 1 ? 'place' : 'places'}</span>
                      )}
                      {hasMovement && topMoveDelta !== null && topMoveDelta < 0 && (
                        <span class="chip chip--down">▼ {Math.abs(topMoveDelta)} {Math.abs(topMoveDelta) === 1 ? 'place' : 'places'}</span>
                      )}
                    </div>
                  </div>
                </div>
              )
            }

            {
              drillArtist ? (
                <div class="drill-head">
                  <a class="drill-back mono" href={buildHref({ artist: null })}>‹ Back</a>
                  <span class="drill-title">
                    Songs by <b>{drillArtist}</b>
                  </span>
                </div>
              ) : (
                <div class="rank-head">
                  <div class="rank-tabs mono">
                    {KINDS.map((k) => (
                      <a
                        href={buildHref({ kind: k.value })}
                        class:list={['rank-tab', { 'is-active': k.value === activeKind }]}
                      >
                        {k.label}
                      </a>
                    ))}
                  </div>
                </div>
              )
            }

            {/* Legend — the full key, shown on every sliced view in place of the old terse
                "▲▼ rank change vs. …" sub-label. The row's count is plays in this window; the arrow
                is how many places the entry moved in the ranking. */}
            <p class="rank-legend mono">
              <b>N plays</b> = times played {playsPhrase}
              {hasMovement ? (
                <Fragment>
                  {' · '}
                  <span class="up">▲</span>/<span class="down">▼</span> = places moved vs. {compareText}
                  {' · '}
                  <span class="rank-legend__new">NEW</span> = not ranked {compareText}
                </Fragment>
              ) : (
                ' · ranked by plays'
              )}
            </p>

            <div class="rank-rows">
              {
                entries.length > 0 ? (
                  entries.map((entry) => (
                    <LeaderboardRow entry={entry} showMovement={hasMovement} shape={rowShape} href={rowHref(entry)} />
                  ))
                ) : (
                  <p class="empty-note">
                    {drillArtist ? `No tracks for ${drillArtist} in this window.` : 'Nothing here yet for this window. Try a wider range.'}
                  </p>
                )
              }
            </div>
          </section>

          {/* charts */}
          <section class="panels">
            <div class="panel">
              <div class="panel__title">Listening over time</div>
              <TrendChart points={trendPoints} unit="plays" emptyLabel="Nothing in this window yet." />
            </div>
            <div class="panel">
              <div class="panel__title">When you listen</div>
              <ListeningHeatmap grid={heatmap.grid} max={heatmap.max} />
            </div>
          </section>

        </Fragment>
      )
    }
  </div>

  <template id="dashboard-skeleton-tpl">
    <Skeleton />
  </template>
</AppShell>

<script>
  // Swap the dashboard's content for the loading skeleton the instant an in-page filter
  // navigation (range/kind/genre/custom-date links, all same pathname + new query string) starts —
  // Astro's ClientRouter otherwise just keeps showing the old page until the new one is ready, with
  // no visible loading feedback. Cross-page navigations (login/connect/import) are left alone.
  document.addEventListener('astro:before-preparation', (event) => {
    if (event.to.pathname !== event.from.pathname) return;
    const content = document.getElementById('dashboard-content');
    const tpl = document.getElementById('dashboard-skeleton-tpl');
    if (content instanceof HTMLElement && tpl instanceof HTMLTemplateElement) {
      content.replaceChildren(tpl.content.cloneNode(true));
    }
  });
</script>

<style>
  .dash-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .dash-callout {
    flex: 1 1 240px;
    max-width: 340px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .up {
    color: var(--up);
  }
  .down {
    color: var(--down);
  }

  .load-error {
    margin-top: 16px;
    font-size: 12.5px;
    color: var(--down);
  }

  .dash-ranges {
    margin-top: 22px;
  }

  .history-note {
    margin-top: 12px;
    font-size: 11.5px;
    color: var(--text-3);
  }

  /* ---- hero ---- */
  .hero {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid var(--hairline);
    margin-top: 20px;
  }

  .hero__mosaic {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(72px, 1fr));
    grid-auto-rows: 72px;
    opacity: 0.26;
    filter: saturate(0.75);
    z-index: 0;
  }

  .hero__tile {
    background-size: cover;
    background-position: center;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(8, 8, 10, 0.62), rgba(8, 8, 10, 0.82) 55%, rgba(8, 8, 10, 0.97)),
      radial-gradient(90% 120% at 12% 0%, rgba(208, 162, 78, 0.16), transparent 60%);
  }

  .hero__body {
    position: relative;
    z-index: 2;
    padding: 24px 22px 26px;
  }

  .hero__figure {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  .hero__minutes {
    font-size: clamp(52px, 15vw, 104px);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--text-1);
    font-variant-numeric: tabular-nums;
  }

  .hero__unit {
    font-size: 14px;
    color: var(--text-2);
    padding-bottom: 8px;
    line-height: 1.4;
  }

  .hero__unit b {
    color: var(--gold);
    font-weight: 700;
  }

  .hero__stats {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 22px;
  }

  .ministat {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .ministat__v {
    font-size: 21px;
    font-weight: 700;
    color: var(--text-1);
    font-variant-numeric: tabular-nums;
  }

  .ministat__l {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .ministat__d {
    font-size: 11px;
    font-weight: 700;
  }

  .hero__compare {
    margin-top: 18px;
    font-size: 11px;
    letter-spacing: 0.03em;
    color: var(--text-3);
  }

  /* ---- #1 card ---- */
  .rank-sec {
    margin-top: 34px;
  }

  .one {
    display: flex;
    align-items: center;
    gap: 16px;
    background: linear-gradient(120deg, rgba(208, 162, 78, 0.1), rgba(255, 255, 255, 0.02) 55%);
    border: 1px solid rgba(208, 162, 78, 0.25);
    border-radius: 16px;
    padding: 16px;
    margin-bottom: 26px;
  }

  .one__art {
    width: 88px;
    height: 88px;
    border-radius: 12px;
    flex: 0 0 auto;
    background-size: cover;
    background-position: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .one__art--circle {
    border-radius: 50%;
  }

  .one__meta {
    min-width: 0;
  }

  .one__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .one__badge::before {
    content: '★';
    font-size: 11px;
  }

  .one__name {
    font-size: clamp(20px, 5.5vw, 28px);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 5px 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .one__sub {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 12.5px;
    color: var(--text-2);
  }

  .one__by {
    color: var(--text-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
  }

  .chip--up {
    color: var(--up);
    background: rgba(139, 185, 150, 0.12);
  }

  .chip--down {
    color: var(--down);
    background: rgba(217, 154, 154, 0.12);
  }

  .chip--new {
    color: var(--gold-on);
    background: var(--gold);
  }

  /* ---- rankings ---- */
  .rank-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--hairline);
  }

  .rank-tabs {
    display: flex;
    gap: 18px;
  }

  .rank-tab {
    padding-bottom: 9px;
    text-decoration: none;
    color: var(--text-3);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    font-size: 13px;
    transition: color 0.15s ease;
  }

  .rank-tab:hover {
    color: var(--text-2);
  }

  .rank-tab.is-active {
    color: var(--text-1);
    font-weight: 700;
    border-bottom-color: var(--gold);
  }

  .drill-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 9px;
  }

  .drill-back {
    font-size: 12.5px;
    color: var(--gold);
    text-decoration: none;
    flex: 0 0 auto;
  }

  .drill-back:hover {
    text-decoration: underline;
  }

  .drill-title {
    font-size: 14px;
    color: var(--text-1);
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .drill-title b {
    font-weight: 700;
  }

  .rank-legend {
    margin-top: 12px;
    font-size: 10.5px;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--text-3);
  }

  .rank-legend b {
    color: var(--text-2);
    font-weight: 700;
  }

  .rank-legend__new {
    color: var(--gold);
