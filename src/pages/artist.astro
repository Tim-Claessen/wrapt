---
// A single-artist deep dive, reached by searching a name (no nav entry — linked from History).
// Flow: ?q= is a loose search (substring match via artist_search); ?name= is an exact, resolved
// artist. A single ?q= match redirects straight to ?name= for a clean, bookmarkable URL; multiple
// matches render a pick-list; zero matches falls back to the empty state.
import AppShell from '../layouts/AppShell.astro';
import LeaderboardRow from '../components/LeaderboardRow.astro';
import EmptyState from '../components/EmptyState.astro';
import { requireProfile } from '../lib/auth';
import { searchArtists, getArtistSummary, getRandomArtists } from '../lib/artist';
import { getLeaderboard } from '../lib/leaderboard';
import { formatCompactNumber, formatMinutes, DISPLAY_TIME_ZONE } from '../lib/format';

const gate = await requireProfile<{ id: string }>(Astro, 'id');
if (gate instanceof Response) return gate;
const { profile, service } = gate;

const url = Astro.url;
const qParam = (url.searchParams.get('q') ?? '').trim();
const nameParam = (url.searchParams.get('name') ?? '').trim();

let matches: Awaited<ReturnType<typeof searchArtists>> = [];
if (!nameParam && qParam) {
  matches = await searchArtists(service, profile.id, qParam, 8);
  if (matches.length === 1) {
    return Astro.redirect(`/artist?name=${encodeURIComponent(matches[0].artistName)}`);
  }
}

let randomArtists: Awaited<ReturnType<typeof getRandomArtists>> = [];
if (!nameParam && !qParam) {
  randomArtists = await getRandomArtists(service, profile.id, 10);
}

let summary: Awaited<ReturnType<typeof getArtistSummary>> = null;
let topTracks: Awaited<ReturnType<typeof getLeaderboard>>['entries'] = [];
if (nameParam) {
  summary = await getArtistSummary(service, profile.id, nameParam);
  if (summary) {
    const result = await getLeaderboard({
      supabase: service,
      profileId: profile.id,
      kind: 'tracks',
      window: 'all',
      artist: summary.artistName,
      limit: 10,
    });
    topTracks = result.entries;
  }
}

function absolute(date: Date): string {
  return date.toLocaleDateString('en-GB', {
    timeZone: DISPLAY_TIME_ZONE,
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });
}

const rawMinutes = summary ? Math.round(summary.totalMs / 60000) : 0;
---

<AppShell title="Artist" wide nav>
  <div class="artist">
    <header class="artist__head">
      <span class="eyebrow mono">Artist</span>
      <h1 class="artist__title">Look up one artist</h1>
      <p class="artist__lede">Search anyone you've played to see their full story — plays, minutes, and where it started.</p>
    </header>

    <form method="get" class="search" id="artist-search-form" autocomplete="off">
      <div class="search__wrap">
        <input
          type="search"
          name="q"
          value={nameParam || qParam}
          placeholder="Search an artist…"
          class="search__input mono"
          id="artist-search-input"
          autofocus
          required
          minlength="2"
        />
        <div class="search__dropdown" id="artist-search-dropdown" hidden></div>
      </div>
      <button type="submit" class="search__submit">Search</button>
    </form>

    {
      !nameParam && !qParam && randomArtists.length > 0 && (
        <section class="chips">
          <p class="chips__label mono">Or jump to one you've played</p>
          <div class="chips__list">
            {randomArtists.map((a, i) => (
              <a
                href={`/artist?name=${encodeURIComponent(a.artistName)}`}
                class="chip riseIn"
                style={`animation-delay:${i * 45}ms`}
              >
                <div class="chip__art">
                  {a.image ? <img src={a.image} alt="" loading="lazy" /> : <div class="chip__art-fallback" />}
                </div>
                <span class="chip__name">{a.artistName}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      nameParam && !summary && (
        <EmptyState
          title="No plays found"
          body={`We couldn't find any plays by "${nameParam}". Check the spelling, or try a shorter search.`}
          hint="◷ new plays and imports add artists as they land…"
        />
      )
    }

    {
      !nameParam && qParam && matches.length === 0 && (
        <EmptyState
          title="No matches"
          body={`Nothing in your history matches "${qParam}".`}
          hint="◷ try a shorter or different spelling…"
        />
      )
    }

    {
      !nameParam && matches.length > 1 && (
        <section class="matches">
          <p class="matches__label mono">{matches.length} artists match "{qParam}"</p>
          <div class="matches__list">
            {matches.map((m, i) => (
              <a
                href={`/artist?name=${encodeURIComponent(m.artistName)}`}
                class="match riseIn"
                style={`animation-delay:${i * 45}ms`}
              >
                <div class="match__art">
                  {m.image ? <img src={m.image} alt="" loading="lazy" /> : <div class="match__art-fallback" />}
                </div>
                <div class="match__meta">
                  <div class="match__name">{m.artistName}</div>
                  <div class="match__plays mono">{m.playCount.toLocaleString()} plays</div>
                </div>
                <span class="match__chevron" aria-hidden="true">›</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      summary && (
        <Fragment>
          {/* Hero — same DNA as the dashboard's MinutesHero (blurred art backdrop, scrim, big
              tabular-nums headline, mini-stat row), built around this one artist's own photo
              instead of a mosaic — the single-subject counterpart to the dashboard's collection. */}
          <section class="hero">
            <div
              class="hero__backdrop"
              aria-hidden="true"
              style={summary.image ? `background-image:url('${summary.image}')` : 'background:linear-gradient(145deg,#4a4538,#1a1812)'}
            />
            <div class="hero__scrim" aria-hidden="true" />
            <div class="hero__body">
              <div class="hero__id">
                <div class="hero__art">
                  {summary.image ? <img src={summary.image} alt="" /> : <div class="hero__art-fallback" />}
                </div>
                <div class="hero__idmeta">
                  <span class="eyebrow mono">Artist</span>
                  <h2 class="hero__name">{summary.artistName}</h2>
                </div>
              </div>

              <div class="hero__figure">
                <div class="hero__minutes mono">{rawMinutes.toLocaleString()}</div>
                <div class="hero__unit">
                  minutes listened
                  <br />
                  <b>{formatCompactNumber(summary.totalPlays)} plays</b> all-time
                </div>
              </div>

              <div class="hero__stats">
                <div class="ministat">
                  <span class="ministat__v mono">{summary.firstPlayedAt ? absolute(summary.firstPlayedAt) : '—'}</span>
                  <span class="ministat__l mono">First listened</span>
                </div>
                <div class="ministat">
                  <span class="ministat__v mono">{summary.bestYear ?? '—'}</span>
                  <span class="ministat__l mono">Biggest year{summary.bestYear ? ` · ${formatMinutes(summary.bestYearMs)}` : ''}</span>
                </div>
              </div>
            </div>
          </section>

          {
            summary.firstTrackName && (
              <div class="first-song">
                <span class="first-song__icon" aria-hidden="true">♪</span>
                <div class="first-song__text">
                  <span class="first-song__label mono">First song you heard</span>
                  <span class="first-song__track">{summary.firstTrackName}</span>
                </div>
              </div>
            )
          }

          <section class="top-tracks">
            <div class="top-tracks__title">Most played songs</div>
            <div class="top-tracks__rows">
              {
                topTracks.length > 0 ? (
                  topTracks.map((entry, i) => (
                    <div class="riseIn" style={`animation-delay:${i * 45}ms`}>
                      <LeaderboardRow entry={entry} showMovement={false} shape="square" href={null} />
                    </div>
                  ))
                ) : (
                  <p class="empty-note">No tracks logged for this artist yet.</p>
                )
              }
            </div>
          </section>
        </Fragment>
      )
    }
  </div>

  <script>
    interface ArtistMatch {
      artistName: string;
      playCount: number;
      image: string | null;
    }

    const form = document.getElementById('artist-search-form') as HTMLFormElement;
    const input = document.getElementById('artist-search-input') as HTMLInputElement;
    const dropdown = document.getElementById('artist-search-dropdown') as HTMLDivElement;

    let debounceHandle: ReturnType<typeof setTimeout> | undefined;
    let activeController: AbortController | undefined;
    let highlighted = -1;

    function closeDropdown(): void {
      dropdown.hidden = true;
      dropdown.replaceChildren();
      highlighted = -1;
    }

    function renderMatches(matches: ArtistMatch[]): void {
      dropdown.replaceChildren();
      highlighted = -1;
      if (matches.length === 0) {
        dropdown.hidden = true;
        return;
      }
      for (const m of matches) {
        const row = document.createElement('a');
        row.href = `/artist?name=${encodeURIComponent(m.artistName)}`;
        row.className = 'search__option';

        const art = document.createElement('div');
        art.className = 'search__option-art';
        if (m.image) {
          const img = document.createElement('img');
          img.src = m.image;
          img.alt = '';
          img.loading = 'lazy';
          art.appendChild(img);
        }

        const meta = document.createElement('div');
        meta.className = 'search__option-meta';
        const name = document.createElement('div');
        name.className = 'search__option-name';
        name.textContent = m.artistName;
        const plays = document.createElement('div');
        plays.className = 'search__option-plays mono';
        plays.textContent = `${m.playCount.toLocaleString()} plays`;
        meta.appendChild(name);
        meta.appendChild(plays);

        row.appendChild(art);
        row.appendChild(meta);
        dropdown.appendChild(row);
      }
      dropdown.hidden = false;
    }

    async function fetchMatches(query: string): Promise<void> {
      activeController?.abort();
      const controller = new AbortController();
      activeController = controller;
      try {
        const response = await fetch(`/api/artist/search?q=${encodeURIComponent(query)}`, {
          signal: controller.signal,
        });
        if (!response.ok) return;
        const { matches } = (await response.json()) as { matches: ArtistMatch[] };
        renderMatches(matches);
      } catch (err) {
        if ((err as Error).name !== 'AbortError') closeDropdown();
      }
    }

    input.addEventListener('input', () => {
      const query = input.value.trim();
      clearTimeout(debounceHandle);
      if (query.length < 2) {
        closeDropdown();
        return;
      }
      debounceHandle = setTimeout(() => fetchMatches(query), 200);
    });

    input.addEventListener('keydown', (event) => {
      const options = Array.from(dropdown.querySelectorAll<HTMLAnchorElement>('.search__option'));
      if (dropdown.hidden || options.length === 0) return;

      if (event.key === 'ArrowDown') {
        event.preventDefault();
        highlighted = Math.min(highlighted + 1, options.length - 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        highlighted = Math.max(highlighted - 1, 0);
      } else if (event.key === 'Enter' && highlighted >= 0) {
        event.preventDefault();
        options[highlighted].click();
        return;
      } else if (event.key === 'Escape') {
        closeDropdown();
        return;
      } else {
        return;
      }

      options.forEach((o, i) => o.classList.toggle('search__option--active', i === highlighted));
      options[highlighted]?.scrollIntoView({ block: 'nearest' });
    });

    document.addEventListener('click', (event) => {
      if (!form.contains(event.target as Node)) closeDropdown();
    });
  </script>
</AppShell>

<style>
  .artist {
    max-width: 720px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .artist__title {
    margin: 6px 0 0;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-1);
  }

  .artist__lede {
    margin: 8px 0 0;
    font-size: 13.5px;
    color: var(--text-2);
    line-height: 1.5;
  }

  /* ---- search ---- */
  .search {
    margin-top: 20px;
    display: flex;
    gap: 10px;
  }

  .search__wrap {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
  }

  .search__input {
    width: 100%;
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-radius: 10px;
    padding: 11px 13px;
    color: var(--text-1);
    font-size: 13px;
  }

  .search__dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    z-index: 20;
    max-height: 320px;
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 12px;
    padding: 4px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  .search__option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
  }

  .search__option:hover,
  .search__option--active {
    background: var(--surface-raised);
  }

  .search__option-art {
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(140deg, #4a4538, #1a1812);
  }

  .search__option-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .search__option-meta {
    min-width: 0;
  }

  .search__option-name {
    font-size: 13.5px;
    color: var(--text-1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search__option-plays {
    margin-top: 2px;
    font-size: 11px;
    color: var(--text-3);
  }

  .search__submit {
    flex: 0 0 auto;
    background: var(--gold);
    color: var(--gold-on);
    border: 0;
    border-radius: 10px;
    padding: 0 18px;
    font-weight: 700;
    font-size: 12.5px;
    font-family: inherit;
    cursor: pointer;
  }

  /* ---- browse chips ----
     Same bordered surface-raised card language as the stat tiles elsewhere in the app (History's
     hero stats, the old per-artist stat grid) — not a standalone pill style. */
  .chips {
    margin-top: 24px;
  }

  .chips__label {
    font-size: 11.5px;
    color: var(--text-3);
    margin-bottom: 10px;
  }

  .chips__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
    gap: 10px;
  }

  .chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 14px 8px;
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    text-decoration: none;
    color: var(--text-1);
    text-align: center;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .chip:hover {
    border-color: var(--gold);
    transform: translateY(-2px);
  }

  .chip__art {
    flex: 0 0 auto;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(140deg, #4a4538, #1a1812);
  }

  .chip__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .chip__art-fallback {
    width: 100%;
    height: 100%;
  }

  .chip__name {
    width: 100%;
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---- match list ---- */
  .matches {
    margin-top: 24px;
  }

  .matches__label {
    font-size: 11.5px;
    color: var(--text-3);
    margin-bottom: 10px;
  }

  .matches__list {
    display: flex;
    flex-direction: column;
  }

  .match {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 8px;
    margin: 0 -8px;
    border-radius: 10px;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
    color: inherit;
    transition: background 0.12s ease;
  }

  .match:hover {
    background: var(--surface-raised);
  }

  .match__art {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(140deg, #4a4538, #1a1812);
  }

  .match__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .match__art-fallback {
    width: 100%;
    height: 100%;
  }

  .match__meta {
    flex: 1 1 auto;
    min-width: 0;
  }

  .match__name {
    font-size: 14.5px;
    color: var(--text-1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .match__plays {
    margin-top: 2px;
    font-size: 11.5px;
    color: var(--text-3);
  }

  .match__chevron {
    flex: 0 0 auto;
    color: var(--text-4);
    font-size: 18px;
  }

  /* ---- hero ----
     Mirrors MinutesHero on the dashboard (blurred backdrop, scrim, big tabular-nums headline,
     mini-stat row) built around this one artist's own photo instead of a mosaic of many. */
  .hero {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid var(--hairline);
    margin-top: 30px;
  }

  .hero__backdrop {
    position: absolute;
    inset: -20%;
    background-size: cover;
    background-position: center;
    filter: blur(36px) saturate(0.85) brightness(0.75);
    opacity: 0.6;
    z-index: 0;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(8, 8, 10, 0.55), rgba(8, 8, 10, 0.85) 60%, rgba(8, 8, 10, 0.97)),
      radial-gradient(90% 120% at 12% 0%, rgba(208, 162, 78, 0.16), transparent 60%);
  }

  .hero__body {
    position: relative;
    z-index: 2;
    padding: 22px 22px 26px;
  }

  .hero__id {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .hero__art {
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(140deg, #4a4538, #1a1812);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .hero__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero__art-fallback {
    width: 100%;
    height: 100%;
  }

  .hero__idmeta {
    min-width: 0;
  }

  .hero__name {
    margin: 3px 0 0;
    font-size: clamp(19px, 5vw, 25px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero__figure {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 18px;
  }

  .hero__minutes {
    font-size: clamp(44px, 13vw, 84px);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--text-1);
    font-variant-numeric: tabular-nums;
  }

  .hero__unit {
    font-size: 13px;
    color: var(--text-2);
    padding-bottom: 6px;
    line-height: 1.4;
  }

  .hero__unit b {
    color: var(--gold);
    font-weight: 700;
  }

  .hero__stats {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .ministat {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .ministat__v {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-1);
    font-variant-numeric: tabular-nums;
  }

  .ministat__l {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* ---- first song ---- */
  .first-song {
    margin-top: 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 12px 16px;
  }

  .first-song__icon {
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(208, 162, 78, 0.14);
    color: var(--gold);
    font-size: 14px;
  }

  .first-song__text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .first-song__label {
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .first-song__track {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ---- top tracks ---- */
  .top-tracks {
    margin-top: 30px;
  }

  .top-tracks__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-1);
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 10px;
  }

  .top-tracks__rows {
    margin-top: 4px;
  }

  .empty-note {
    margin-top: 20px;
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.5;
  }

  /* ---- countdown-style reveal, used by the browse chips, search matches, and top tracks ---- */
  .riseIn {
    animation: riseIn 0.3s ease both;
  }

  @keyframes riseIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
