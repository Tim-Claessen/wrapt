---
import AppShell from '../layouts/AppShell.astro';
import { requireProfile } from '../lib/auth';
import { getAskRemaining } from '../lib/ask';
import { getPlaylistRemaining } from '../lib/playlist';

const gate = await requireProfile<{ id: string; display_name: string | null; scopes: string[] | null }>(
  Astro,
  'id, display_name, scopes',
);
if (gate instanceof Response) return gate;
const { profile, service } = gate;

const [usage, playlistUsage] = await Promise.all([
  getAskRemaining(service, profile.id),
  getPlaylistRemaining(service, profile.id),
]);
const hasPlaylistScope = (profile.scopes ?? []).includes('playlist-modify-private');
const skeletonRows = Array.from({ length: 12 });
---

<AppShell title="Ask" wide nav>
  <div class="ask-page" data-remaining={usage.remaining} data-limit={usage.limit}>
    <header class="ask-head">
      <span class="eyebrow mono">Ask</span>
      <h1 class="ask-title">Ask your listening anything.</h1>
      <p class="ask-lede">Real answers from your own history — no vibes, just the numbers.</p>
    </header>

    <div class="tabs mono" role="tablist">
      <button class="tab is-active" data-mode="ask" role="tab" aria-selected="true">Ask</button>
      <button class="tab" data-mode="playlist" role="tab" aria-selected="false">Playlist</button>
    </div>

    <section id="panel-ask" class="mode">
      <div id="ask-body" class="ask-body">
        <div id="chat-log" class="chat"></div>

        <form id="ask-form" class="composer" autocomplete="off">
          <input
            id="ask-input"
            class="composer__input"
            type="text"
            name="question"
            placeholder="Ask about your listening…"
            maxlength="500"
            aria-label="Ask about your listening"
          />
          <button id="ask-send" class="composer__send mono" type="submit">Ask</button>
        </form>
        <p id="ask-hint" class="composer__hint mono">{usage.remaining} of {usage.limit} questions left today.</p>
      </div>
    </section>

    <section id="panel-playlist" class="mode" hidden>
      <div
        id="playlist-body"
        class="playlist-body"
        data-remaining={playlistUsage.remaining}
        data-limit={playlistUsage.limit}
        data-has-scope={hasPlaylistScope ? '1' : '0'}
      >
        <p class="playlist-note mono">
          Suggestions come from AI music knowledge seeded with your listening — not Spotify's recommendation engine.
        </p>

        <div class="dial mono" role="tablist" aria-label="Familiarity">
          <button class="dial__pill is-active" type="button" data-dial="my_music" role="tab" aria-selected="true">My music</button>
          <button class="dial__pill" type="button" data-dial="mix" role="tab" aria-selected="false">Mix</button>
          <button class="dial__pill" type="button" data-dial="discovery" role="tab" aria-selected="false">Discovery</button>
        </div>

        <form id="playlist-form" class="composer" autocomplete="off">
          <input
            id="playlist-input"
            class="composer__input"
            type="text"
            name="brief"
            placeholder="rainy Sunday cooking, gym energy…"
            maxlength="200"
            aria-label="Playlist brief"
          />
          <button id="playlist-send" class="composer__send mono" type="submit">Generate</button>
        </form>
        <p id="playlist-hint" class="composer__hint mono">
          {playlistUsage.remaining} of {playlistUsage.limit} playlists left today.
        </p>

        <div id="playlist-skeleton" class="playlist-skeleton" hidden aria-hidden="true">
          {skeletonRows.map((_, i) => <div class="playlist-skeleton__row" style={`animation-delay:${i * 40}ms;`} />)}
        </div>

        <div id="playlist-result" class="playlist-result"></div>
      </div>
    </section>
  </div>
</AppShell>

<script>
  import { formatDuration } from '../lib/format';

  type Rich = { type: 'table'; title: string; columns: string[]; rows: string[][] };
  interface AskResponse {
    answer?: string;
    rich?: Rich | null;
    remaining?: number;
    capped?: boolean;
    error?: string;
  }

  const root = document.querySelector('.ask-page') as HTMLElement;
  const askBody = document.getElementById('ask-body') as HTMLDivElement;
  const chatLog = document.getElementById('chat-log') as HTMLDivElement;
  const form = document.getElementById('ask-form') as HTMLFormElement;
  const input = document.getElementById('ask-input') as HTMLInputElement;
  const sendBtn = document.getElementById('ask-send') as HTMLButtonElement;
  const hint = document.getElementById('ask-hint') as HTMLParagraphElement;
  const limit = Number(root.dataset.limit ?? '50');
  let remaining = Number(root.dataset.remaining ?? '0');
  let busy = false;

  // ---- mode tabs (Ask / Playlist) ----
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
  const panelAsk = document.getElementById('panel-ask') as HTMLElement;
  const panelPlaylist = document.getElementById('panel-playlist') as HTMLElement;
  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      const mode = tab.dataset.mode;
      for (const t of tabs) {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      }
      panelAsk.hidden = mode !== 'ask';
      panelPlaylist.hidden = mode !== 'playlist';
    });
  }

  // ---- helpers ----
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function scrollToEnd(): void {
    chatLog.scrollTop = chatLog.scrollHeight;
  }

  function updateHint(): void {
    hint.textContent =
      remaining <= 0
        ? "That's today's questions used up — back tomorrow."
        : `${remaining} of ${limit} question${remaining === 1 ? '' : 's'} left today.`;
  }

  function addUserBubble(text: string): void {
    const msg = el('div', 'msg msg--user');
    msg.appendChild(el('div', 'bubble', text));
    chatLog.appendChild(msg);
    scrollToEnd();
  }

  function addThinking(): HTMLDivElement {
    const msg = el('div', 'msg msg--bot');
    const bubble = el('div', 'bubble bubble--thinking');
    bubble.appendChild(el('span', 'mono', 'reading your history…'));
    msg.appendChild(bubble);
    chatLog.appendChild(msg);
    scrollToEnd();
    return msg;
  }

  // A numeric-looking cell (int/float, optionally with a %/comma) reads better in mono, like the
  // rest of the app's figures.
  function isNumericCell(v: string): boolean {
    return /^-?[\d,]+(\.\d+)?%?$/.test(v.trim());
  }

  function buildTableRich(rich: Rich): HTMLElement {
    const wrap = el('div', 'rich rich--table');
    wrap.appendChild(el('div', 'rich__title mono', rich.title));
    const scroll = el('div', 'rich__tablescroll');
    const table = el('table', 'rtable');

    const thead = el('thead');
    const htr = el('tr');
    for (const col of rich.columns) htr.appendChild(el('th', 'mono', col));
    thead.appendChild(htr);
    table.appendChild(thead);

    const tbody = el('tbody');
    rich.rows.forEach((row, i) => {
      const tr = el('tr');
      tr.style.animationDelay = `${i * 35}ms`;
      row.forEach((cell) => {
        const td = el('td', isNumericCell(cell) ? 'mono rtable__num' : undefined, cell);
        tr.appendChild(td);
      });
      tbody.appendChild(tr);
    });
    table.appendChild(tbody);
    scroll.appendChild(table);
    wrap.appendChild(scroll);
    return wrap;
  }

  function addBotAnswer(text: string, rich: Rich | null): void {
    const msg = el('div', 'msg msg--bot');
    msg.appendChild(el('div', 'bubble', text));
    if (rich && rich.type === 'table' && rich.rows.length > 0) msg.appendChild(buildTableRich(rich));
    chatLog.appendChild(msg);
    scrollToEnd();
  }

  function setBusy(state: boolean): void {
    busy = state;
    input.disabled = state;
    sendBtn.disabled = state || remaining <= 0;
    sendBtn.textContent = state ? '…' : 'Ask';
  }

  async function ask(question: string): Promise<void> {
    if (busy || !question.trim()) return;
    if (remaining <= 0) {
      updateHint();
      return;
    }
    askBody.classList.add('has-messages');
    addUserBubble(question);
    input.value = '';
    setBusy(true);
    const thinking = addThinking();

    try {
      const res = await fetch('/api/ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question }),
      });
      const data = (await res.json().catch(() => ({}))) as AskResponse;
      thinking.remove();

      if (typeof data.remaining === 'number') remaining = data.remaining;
      else if (!data.capped && res.ok) remaining = Math.max(remaining - 1, 0);

      const answer = data.answer ?? "Something went wrong on my end — try that again in a moment.";
      addBotAnswer(answer, data.rich ?? null);
    } catch {
      thinking.remove();
      addBotAnswer("I couldn't reach the server just now — check your connection and try again.", null);
    } finally {
      updateHint();
      setBusy(false);
      if (remaining > 0) input.focus();
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    void ask(input.value);
  });

  updateHint();
  setBusy(false);

  // ---- Playlist tab ----
  interface PlaylistTrack {
    id: string;
    uri: string;
    name: string;
    artists: string[];
    image: string | null;
    durationMs: number;
  }
  interface GenerateResponse {
    ok?: boolean;
    name?: string;
    description?: string;
    tracks?: PlaylistTrack[];
    recencyCaveat?: boolean;
    remaining?: number;
    capped?: boolean;
    message?: string;
    error?: string;
  }
  interface SaveResponse {
    ok?: boolean;
    url?: string;
    error?: string;
    message?: string;
  }
  type Dial = 'my_music' | 'mix' | 'discovery';

  const playlistRoot = document.getElementById('playlist-body') as HTMLDivElement;
  const dialButtons = Array.from(playlistRoot.querySelectorAll<HTMLButtonElement>('.dial__pill'));
  const playlistForm = document.getElementById('playlist-form') as HTMLFormElement;
  const playlistInput = document.getElementById('playlist-input') as HTMLInputElement;
  const playlistSend = document.getElementById('playlist-send') as HTMLButtonElement;
  const playlistHint = document.getElementById('playlist-hint') as HTMLParagraphElement;
  const playlistSkeleton = document.getElementById('playlist-skeleton') as HTMLDivElement;
  const playlistResult = document.getElementById('playlist-result') as HTMLDivElement;
  const playlistLimit = Number(playlistRoot.dataset.limit ?? '10');
  const hasPlaylistScope = playlistRoot.dataset.hasScope === '1';
  let playlistRemaining = Number(playlistRoot.dataset.remaining ?? '0');
  let dial: Dial = 'my_music';
  let playlistBusy = false;

  for (const btn of dialButtons) {
    btn.addEventListener('click', () => {
      dial = btn.dataset.dial as Dial;
      for (const b of dialButtons) {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      }
    });
  }

  function updatePlaylistHint(): void {
    playlistHint.textContent =
      playlistRemaining <= 0
        ? "That's today's playlists used up — back tomorrow."
        : `${playlistRemaining} of ${playlistLimit} playlist${playlistRemaining === 1 ? '' : 's'} left today.`;
  }

  function setPlaylistBusy(state: boolean): void {
    playlistBusy = state;
    playlistInput.disabled = state;
    playlistSend.disabled = state || playlistRemaining <= 0;
    playlistSend.textContent = state ? '…' : 'Generate';
    playlistSkeleton.hidden = !state;
    if (state) playlistResult.innerHTML = '';
  }

  function playlistNote(text: string): HTMLParagraphElement {
    return el('p', 'presult__caveat mono', text);
  }

  function reconnectNote(prefix: string, href: string): HTMLParagraphElement {
    const p = el('p', 'presult__caveat mono', prefix);
    const link = el('a', 'presult__reconnect mono', 'reconnect Spotify');
    link.href = href;
    p.appendChild(link);
    return p;
  }

  function trackRow(track: PlaylistTrack, index: number): HTMLElement {
    const row = el('div', 'ptrack');
    row.style.animationDelay = `${index * 50}ms`;
    const art = el('div', 'ptrack__art');
    if (track.image) {
      const img = document.createElement('img');
      img.src = track.image;
      img.alt = '';
      img.loading = 'lazy';
      art.appendChild(img);
    }
    row.appendChild(art);
    const meta = el('div', 'ptrack__meta');
    meta.appendChild(el('div', 'ptrack__title', track.name));
    meta.appendChild(el('div', 'ptrack__artist', track.artists.join(', ')));
    row.appendChild(meta);
    const dur = el('a', 'ptrack__dur mono', formatDuration(track.durationMs));
    dur.href = `https://open.spotify.com/track/${track.id}`;
    dur.target = '_blank';
    dur.rel = 'noopener noreferrer';
    row.appendChild(dur);
    return row;
  }

  async function savePlaylist(
    name: string,
    description: string,
    tracks: PlaylistTrack[],
    btn: HTMLButtonElement,
    wrap: HTMLElement,
  ): Promise<void> {
    btn.disabled = true;
    btn.textContent = 'Saving…';
    try {
      const res = await fetch('/api/playlist/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, description, trackUris: tracks.map((t) => t.uri) }),
      });
      const data = (await res.json().catch(() => ({}))) as SaveResponse;
      if (data.ok && data.url) {
        wrap.innerHTML = '';
        const link = el('a', 'btn-save btn-save--done mono', 'Open in Spotify →');
        link.href = data.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        wrap.appendChild(link);
        return;
      }
      if (data.error === 'scope_missing' || data.error === 'reconnect_required') {
        wrap.innerHTML = '';
        wrap.appendChild(reconnectNote('Wrapt needs one new permission to save playlists — ', '/api/auth/spotify'));
        return;
      }
      btn.disabled = false;
      btn.textContent = 'Save to Spotify';
      wrap.appendChild(playlistNote(data.message ?? "Couldn't save that playlist — try again."));
    } catch {
      btn.disabled = false;
      btn.textContent = 'Save to Spotify';
      wrap.appendChild(playlistNote("Couldn't reach the server — check your connection and try again."));
    }
  }

  function renderResult(name: string, description: string, tracks: PlaylistTrack[], recencyCaveat: boolean): void {
    playlistResult.innerHTML = '';

    const header = el('div', 'presult__head');
    header.appendChild(el('div', 'presult__name', name));
    if (description) header.appendChild(el('p', 'presult__desc', description));
    if (recencyCaveat) {
      header.appendChild(
        playlistNote("Heads up — I can't guarantee this reflects brand-new releases; these picks lean on music I actually know."),
      );
    }
    playlistResult.appendChild(header);

    const list = el('div', 'ptracks');
    tracks.forEach((t, i) => list.appendChild(trackRow(t, i)));
    playlistResult.appendChild(list);

    const saveWrap = el('div', 'presult__save');
    if (hasPlaylistScope) {
      const saveBtn = el('button', 'btn-save mono', 'Save to Spotify');
      saveBtn.type = 'button';
      saveWrap.appendChild(saveBtn);
      saveBtn.addEventListener('click', () => void savePlaylist(name, description, tracks, saveBtn, saveWrap));
    } else {
      saveWrap.appendChild(reconnectNote('Wrapt needs one new permission to save playlists — ', '/api/auth/spotify'));
    }
    playlistResult.appendChild(saveWrap);
  }

  async function generatePlaylist(brief: string): Promise<void> {
    if (playlistBusy || !brief.trim()) return;
    if (playlistRemaining <= 0) {
      updatePlaylistHint();
      return;
    }
    setPlaylistBusy(true);

    try {
      const res = await fetch('/api/playlist/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ brief, dial }),
      });
      const data = (await res.json().catch(() => ({}))) as GenerateResponse;
      if (typeof data.remaining === 'number') playlistRemaining = data.remaining;

      if (data.error === 'reconnect_required') {
        playlistResult.innerHTML = '';
        playlistResult.appendChild(reconnectNote('Your Spotify connection needs refreshing — ', '/api/auth/spotify'));
      } else if (data.capped) {
        playlistResult.innerHTML = '';
        playlistResult.appendChild(playlistNote(data.message ?? "That's today's playlists used up."));
      } else if (!data.ok || !data.tracks) {
        playlistResult.innerHTML = '';
        playlistResult.appendChild(
          playlistNote(data.message ?? 'Something went wrong on my end — try that again in a moment.'),
        );
      } else {
        renderResult(data.name ?? 'Your mix', data.description ?? '', data.tracks, Boolean(data.recencyCaveat));
      }
    } catch {
      playlistResult.innerHTML = '';
      playlistResult.appendChild(playlistNote("I couldn't reach the server just now — check your connection and try again."));
    } finally {
      updatePlaylistHint();
      setPlaylistBusy(false);
    }
  }

  playlistForm.addEventListener('submit', (event) => {
    event.preventDefault();
    void generatePlaylist(playlistInput.value);
  });

  updatePlaylistHint();
  setPlaylistBusy(false);
</script>

<style is:global>
  /* Namespaced under .ask-page so these rules also style the chat bubbles created in client JS
     (Astro's default scoped styles only reach server-rendered nodes, which the bubbles aren't). */
  .ask-page .eyebrow {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .ask-page .ask-title {
    margin: 6px 0 0;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-1);
  }

  .ask-page .ask-lede {
    margin: 8px 0 0;
    font-size: 14.5px;
    color: var(--text-2);
    line-height: 1.5;
  }

  .ask-page .tabs {
    display: inline-flex;
    gap: 4px;
    margin-top: 22px;
    padding: 4px;
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-radius: 12px;
  }

  .ask-page .tab {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--text-3);
    font-size: 12.5px;
    padding: 8px 18px;
    border-radius: 9px;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .ask-page .tab:hover {
    color: var(--text-2);
  }

  .ask-page .tab.is-active {
    color: var(--gold-on);
    background: var(--gold);
    font-weight: 700;
  }

  .ask-page .mode {
    margin-top: 22px;
  }

  /* ---- chat ----
     Before any question is asked, .ask-body centers the composer vertically in the space below
     the header (an empty .chat contributes no height, so the composer + hint sit in the middle).
     Once the first question lands, JS adds .has-messages, which drops the centering so the chat
     log takes over the space above a bottom-anchored composer — the usual chat layout. */
  .ask-page .ask-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 44vh;
  }

  .ask-page .ask-body.has-messages {
    justify-content: flex-start;
    min-height: 0;
  }

  .ask-page .chat {
    max-height: min(58vh, 560px);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 4px 2px;
  }

  .ask-page .msg {
    display: flex;
    animation: riseIn 0.28s ease both;
  }

  .ask-page .msg--user {
    justify-content: flex-end;
  }

  .ask-page .msg--bot {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .ask-page .bubble {
    max-width: 86%;
    font-size: 14.5px;
    line-height: 1.5;
    padding: 11px 15px;
    border-radius: 16px;
  }

  .ask-page .msg--user .bubble {
    background: var(--gold);
    color: var(--gold-on);
    border-bottom-right-radius: 5px;
    font-weight: 500;
  }

  .ask-page .msg--bot .bubble {
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    color: var(--text-1);
    border-bottom-left-radius: 5px;
  }

  .ask-page .bubble--thinking {
    color: var(--text-3);
    font-size: 12.5px;
  }

  .ask-page .bubble--thinking .mono {
    background: linear-gradient(90deg, var(--text-3), var(--text-1), var(--text-3));
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: askShimmer 1.4s ease-in-out infinite;
  }

  @keyframes askShimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  /* ---- rich blocks ---- */
  .ask-page .rich {
    width: 100%;
    max-width: 440px;
    background: var(--surface-raised);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 14px;
  }

  .ask-page .rich__title {
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 12px;
  }

  .ask-page .rich__rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ask-page .rrow {
    display: flex;
    align-items: center;
    gap: 11px;
    animation: riseIn 0.3s ease both;
  }

  .ask-page .rrow__rank {
    flex: 0 0 18px;
    text-align: right;
    font-size: 12px;
    color: var(--text-3);
  }

  .ask-page .rrow__art {
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background-size: cover;
    background-position: center;
  }

  .ask-page .rrow__art--circle {
    border-radius: 50%;
  }

  .ask-page .rrow__meta {
    flex: 1 1 auto;
    min-width: 0;
  }

  .ask-page .rrow__name {
    font-size: 13.5px;
    color: var(--text-1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ask-page .rrow__sub {
    font-size: 11.5px;
    color: var(--text-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ask-page .rrow__metric {
    flex: 0 0 auto;
    font-size: 11px;
    color: var(--text-2);
    text-align: right;
  }

  .ask-page .rich__tablescroll {
    overflow-x: auto;
  }

  .ask-page .rtable {
    border-collapse: collapse;
    width: 100%;
    font-size: 12.5px;
  }

  .ask-page .rtable th {
    text-align: left;
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
    font-weight: 400;
    padding: 0 12px 8px 0;
    white-space: nowrap;
    border-bottom: 1px solid var(--hairline);
  }

  .ask-page .rtable td {
    padding: 8px 12px 8px 0;
    color: var(--text-1);
    border-bottom: 1px solid var(--hairline);
    white-space: nowrap;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ask-page .rtable tbody tr {
    animation: riseIn 0.3s ease both;
  }

  .ask-page .rtable tbody tr:last-child td {
    border-bottom: 0;
  }

  .ask-page .rtable__num {
    color: var(--text-2);
  }

  /* ---- composer ---- */
  .ask-page .composer {
    display: flex;
    gap: 8px;
    margin-top: 16px;
  }

  .ask-page .composer__input {
    flex: 1 1 auto;
    min-width: 0;
